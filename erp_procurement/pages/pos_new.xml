<page roles="purchase_user,purchase_admin" route="/erp/procurement/pos/new" title="New purchase order" model="po" menu="false">
  <view type="form" function="create_po" submit="Create order" success="Order created" redirect="/erp/procurement/pos">
    <group title="Order" cols="2">
      <field name="company" label="Company" required="true" source="company.list_companies" optionLabel="name" entity="companies"/>
      <field name="supplier" label="Supplier" required="true" source="party.list_parties" optionLabel="display_name" entity="parties"/>
      <field name="warehouse" label="Receive into" source="erp_inventory.search_warehouses" optionLabel="name" entity="warehouses"/>
      <field name="order_date" label="Order date" fieldType="date"/>
      <field name="payment_term" label="Payment term" source="erp_pricing.list_payment_terms" optionLabel="name" entity="terms"/>
      <field name="price_list" label="Buy price list" source="erp_pricing.list_price_lists" optionLabel="name" entity="price_lists"/>
      <field name="notes" label="Notes"/>
    </group>
  </view>
</page>
