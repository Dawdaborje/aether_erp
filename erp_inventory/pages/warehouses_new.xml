<page roles="stock_admin" route="/erp/inventory/warehouses/new" title="New warehouse" model="stock_warehouse" menu="false">
  <view type="form" function="create_warehouse" submit="Add warehouse" success="Warehouse added" redirect="/erp/inventory/warehouses">
    <group title="Warehouse" cols="2">
      <field name="code" label="Code" required="true"/>
      <field name="name" label="Name" required="true"/>
      <field name="company" label="Company" required="true" source="company.list_companies" optionLabel="name" entity="companies"/>
      <field name="parent" label="Parent" source="search_warehouses" entity="warehouses"/>
      <field name="kind" label="Kind" fieldType="selection" options="stock, view, transit, scrap"/>
    </group>
  </view>
</page>
