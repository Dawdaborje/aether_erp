<page roles="wh_user,wh_admin" route="/erp/warehouse/picks/new" title="New pick list" model="pick_list" menu="false">
  <view type="form" function="create_pick_list" submit="Create pick list" success="Pick list created" redirect="/erp/warehouse/picks">
    <group title="Pick list" cols="2">
      <field name="company" label="Company" required="true" source="company.list_companies" optionLabel="name" entity="companies"/>
      <field name="warehouse" label="Warehouse" required="true" source="erp_inventory.list_warehouses" entity="warehouses"/>
      <field name="so" label="Sales order" source="erp_selling.list_sos" optionLabel="number" entity="orders"/>
    </group>
  </view>
</page>
