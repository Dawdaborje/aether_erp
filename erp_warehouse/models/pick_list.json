      "required": true
    },
    {
      "id": "fld_wvnxn049s2",
      "name": "source_kind",
      "label": "%source_kind%",
      "type": "string",
      "max_length": 80,
      "index": "plain"
    },
    {
      "id": "fld_vjinivo8iq",
