<page roles="reports_reader" route="/erp/reports/purchases" title="Purchase report" menu="false">
  <view type="list" source="purchase_report">
    <columns>
      <column field="bill_date" label="Month"/>
      <column field="supplier" label="Supplier"/>
      <column field="documents" label="Bills"/>
      <column field="amount" label="Billed"/>
      <column field="notes" label="Debit notes"/>
      <column field="net" label="Net"/>
      <column field="tax" label="Tax"/>
    </columns>
    <empty title="Nothing to report" description="Approved bills appear here."/>
  </view>
</page>
