<page roles="item_reader,item_admin" route="/erp/items" title="Items" model="item" icon="package" sort="10">
  <view type="list" model="item" source="search_items" open="/erp/items/{id}" create="/erp/items/new" create_label="New item">
    <search/>
    <columns>
      <column field="code" label="Code"/>
      <column field="name" label="Name"/>
      <column field="uom" label="Unit"/>
      <column field="tracking" label="Tracking" fieldType="badge"/>
      <column field="is_stocked" label="Stocked" fieldType="boolean"/>
      <column field="active" label="Active" fieldType="boolean"/>
    </columns>
    <empty title="No items yet" description="Use New to add a stocked or non-stocked item."/>
  </view>
  <buttonbox>
    <button label="Export items" href="/erp/items/export/item" variant="secondary"/>
    <button label="Export categories" href="/erp/items/export/item_category" variant="secondary"/>
    <button label="Import" href="/erp/items/import" variant="secondary"/>
  </buttonbox>
</page>
