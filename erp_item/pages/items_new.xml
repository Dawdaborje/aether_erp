<page roles="item_admin" route="/erp/items/new" title="New item" model="item" menu="false">
  <view type="form" function="create_item" submit="Add item" success="Item added" redirect="/erp/items">
    <group title="Item" cols="2">
      <field name="code" label="Code" required="true"/>
      <field name="name" label="Name" required="true"/>
      <field name="uom" label="Unit" required="true" source="uom.list_units" optionLabel="code" entity="units"/>
      <field name="category" label="Category" source="list_categories" entity="categories"/>
    </group>
    <group title="Tracking" cols="3">
      <field name="tracking" label="Tracking" fieldType="selection" options="none, lot, serial"/>
      <field name="is_stocked" label="Stocked" fieldType="boolean"/>
      <field name="expiry_days" label="Shelf life (days)" fieldType="integer"/>
    </group>
  </view>
</page>
